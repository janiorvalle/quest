{
  "name": "quest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "scripts": {
    "postinstall": "lefthook install",
    "format": "biome check --write .",
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 20000",
    "check": "bun run lint && bun run typecheck && bun run test",
    "convex:deploy": "bun run scripts/convex-deploy.ts",
    "dist": "bun run scripts/dist.ts && bun run scripts/verify-dist.ts",
    "dist:smoke": "bun run dist && bun run scripts/install-smoke.ts"
  },
  "dependencies": {
    "@opentui/react": "0.5.1",
    "@vllnt/convex-api-keys": "0.2.0",
    "commander": "15.0.0",
    "convex": "1.45.0",
    "react": "19.2.8",
    "react-devtools-core": "7.0.1",
    "smol-toml": "1.6.1",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "lefthook": "2.1.10",
    "typescript": "5.9.3"
  }
}
